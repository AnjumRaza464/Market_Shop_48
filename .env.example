# Neon PostgreSQL connection string (Neon console → Connect → pooled connection string)
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/neondb?sslmode=require"

# Optional single-password login for the whole app.
# Leave APP_PASSWORD empty to run without a login screen (local development).
APP_PASSWORD=""
# Random secret used to sign the session cookie. Required when APP_PASSWORD is set.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=""

# Shop details printed on pattis and statements
NEXT_PUBLIC_SHOP_NAME="Market 48 Shop"
NEXT_PUBLIC_SHOP_ADDRESS="Shop 48, Sabzi Mandi"
NEXT_PUBLIC_SHOP_PHONE=""
NEXT_PUBLIC_CURRENCY_SYMBOL="Rs"

# IANA time zone used for "today" defaults on entry forms
APP_TIMEZONE="Asia/Karachi"
