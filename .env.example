# Neon PostgreSQL connection string (Neon console → Connect → pooled connection string)
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/neondb?sslmode=require"

# Login for the whole app (username + password). Both default to admin / 123123
# when left empty - change them before going live.
APP_USERNAME="admin"
APP_PASSWORD="123123"
# Random secret used to sign the session cookie (>=16 chars). Strongly recommended.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=""

# Shop details printed on pattis and statements
NEXT_PUBLIC_SHOP_NAME="Market 48 Shop"
NEXT_PUBLIC_SHOP_ADDRESS="Shop 48, Sabzi Mandi"
NEXT_PUBLIC_SHOP_PHONE=""
NEXT_PUBLIC_CURRENCY_SYMBOL="Rs"

# IANA time zone used for "today" defaults on entry forms
APP_TIMEZONE="Asia/Karachi"
